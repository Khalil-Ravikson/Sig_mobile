{
  "mappings": [
    {
      "name": "login: aluno com 1 vinculo",
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/auth/login",
        "bodyPatterns": [
          { "matchesJsonPath": { "expression": "$.cpf", "equalTo": "00000000001" } },
          { "matchesJsonPath": { "expression": "$.senha", "equalTo": "senha123" } }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "nome": "Maria Teste da Silva",
          "vinculos": [
            { "id": 1, "tipo": "ALUNO", "descricao": "Engenharia Civil", "matricula": "2022001" }
          ],
          "tokenTemporario": "tmp-aluno-1"
        }
      }
    },
